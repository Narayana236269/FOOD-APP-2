    <script>
      const quantityInputs = document.querySelectorAll(".quantity");
      const cartItems = document.getElementById("cartItems");
      const emptyCart = document.getElementById("emptyCart");
      const subtotalElement = document.getElementById("subtotal");
      const deliveryElement = document.getElementById("delivery");
      const totalElement = document.getElementById("total");
      const orderForm = document.getElementById("orderForm");
      const orderAlert = document.getElementById("orderAlert");

      let currentSubtotal = 0;
      let selectedItems = [];

      function formatRupees(amount) {
        return "₹" + amount.toLocaleString("en-IN");
      }

      function updateCart() {
        selectedItems = [];
        currentSubtotal = 0;
        cartItems.replaceChildren();

        quantityInputs.forEach(function (input) {
          const quantity = Number(input.value);
          const price = Number(input.dataset.price);

          if (quantity > 0) {
            const item = {
              name: input.dataset.name,
              quantity: quantity,
              price: price,
              amount: quantity * price,
            };

            selectedItems.push(item);
            currentSubtotal += item.amount;

            const li = document.createElement("li");
            li.className = "list-group-item px-0";

            const row = document.createElement("div");
            row.className = "d-flex justify-content-between gap-2";

            const description = document.createElement("span");
            description.textContent = item.name + " × " + item.quantity;

            const amount = document.createElement("strong");
            amount.textContent = formatRupees(item.amount);

            row.append(description, amount);
            li.appendChild(row);
            cartItems.appendChild(li);
          }
        });

        emptyCart.style.display = selectedItems.length ? "none" : "block";

        const delivery = currentSubtotal > 0 ? 40 : 0;
        const total = currentSubtotal + delivery;

        subtotalElement.textContent = formatRupees(currentSubtotal);
        deliveryElement.textContent = formatRupees(delivery);
        totalElement.textContent = formatRupees(total);
      }

      quantityInputs.forEach(function (input) {
        input.addEventListener("input", function () {
          const quantity = Number(input.value);

          if (!Number.isInteger(quantity) || quantity < 0) {
            input.value = 0;
          } else if (quantity > 20) {
            input.value = 20;
          }

          orderAlert.style.display = "none";
          updateCart();
        });
      });

      // DEMO AUTHENTICATION: localStorage is for learning only.
      // Never store real passwords this way in a production application.
      const authNav = document.getElementById("authNav");
      const userNav = document.getElementById("userNav");
      const navUserName = document.getElementById("navUserName");
      const authModalElement = document.getElementById("authModal");
      const authModal = new bootstrap.Modal(authModalElement);
      const authMessage = document.getElementById("authMessage");
      const loginForm = document.getElementById("loginForm");
      const registerForm = document.getElementById("registerForm");

      function getUsers() {
        try {
          return JSON.parse(localStorage.getItem("foodieUsers")) || [];
        } catch (error) {
          return [];
        }
      }

      function getCurrentUser() {
        try {
          return JSON.parse(sessionStorage.getItem("foodieCurrentUser"));
        } catch (error) {
          return null;
        }
      }

      function updateAuthNavigation() {
        const user = getCurrentUser();
        authNav.classList.toggle("d-none", Boolean(user));
        userNav.classList.toggle("d-none", !user);
        navUserName.textContent = user ? "Hi, " + user.name : "";
      }

      function showAuthMessage(message, type) {
        authMessage.textContent = message;
        authMessage.className = "alert alert-" + type;
      }

      function switchAuthForm(showRegister) {
        loginForm.classList.toggle("d-none", showRegister);
        registerForm.classList.toggle("d-none", !showRegister);
        authMessage.className = "alert d-none";
      }

      document.getElementById("showRegister").addEventListener("click", function () {
        switchAuthForm(true);
      });

      document.getElementById("showLogin").addEventListener("click", function () {
        switchAuthForm(false);
      });

      registerForm.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!registerForm.reportValidity()) return;

        const name = document.getElementById("registerName").value.trim();
        const email = document.getElementById("registerEmail").value.trim().toLowerCase();
        const password = document.getElementById("registerPassword").value;
        const confirmPassword = document.getElementById("confirmPassword").value;

        if (password !== confirmPassword) {
          showAuthMessage("Passwords do not match. Please try again.", "danger");
          return;
        }

        const users = getUsers();
        if (users.some(function (user) { return user.email === email; })) {
          showAuthMessage("An account with this email already exists. Please login.", "warning");
          return;
        }

        // Demo-only storage. Production apps must hash passwords on the server.
        users.push({ name: name, email: email, password: password });
        localStorage.setItem("foodieUsers", JSON.stringify(users));
        sessionStorage.setItem("foodieCurrentUser", JSON.stringify({ name: name, email: email }));

        updateAuthNavigation();
        showAuthMessage("Registration successful! You are now logged in.", "success");
        registerForm.reset();
        setTimeout(function () { authModal.hide(); }, 900);
      });

      loginForm.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!loginForm.reportValidity()) return;

        const email = document.getElementById("loginEmail").value.trim().toLowerCase();
        const password = document.getElementById("loginPassword").value;
        const user = getUsers().find(function (item) {
          return item.email === email && item.password === password;
        });

        if (!user) {
          showAuthMessage("Invalid email or password. Please try again or register.", "danger");
          return;
        }

        sessionStorage.setItem("foodieCurrentUser", JSON.stringify({ name: user.name, email: user.email }));
        updateAuthNavigation();
        showAuthMessage("Login successful. Welcome back, " + user.name + "!", "success");
        loginForm.reset();
        setTimeout(function () { authModal.hide(); }, 900);
      });

      document.getElementById("logoutBtn").addEventListener("click", function () {
        sessionStorage.removeItem("foodieCurrentUser");
        updateAuthNavigation();
        orderAlert.style.display = "block";
        orderAlert.className = "alert alert-info";
        orderAlert.textContent = "You have been logged out.";
      });

      authModalElement.addEventListener("hidden.bs.modal", function () {
        authMessage.className = "alert d-none";
        loginForm.reset();
        registerForm.reset();
        switchAuthForm(false);
      });

      orderForm.addEventListener("submit", function (event) {
        event.preventDefault();

        orderAlert.style.display = "block";
        orderAlert.className = "alert alert-warning";

        if (selectedItems.length === 0) {
          orderAlert.textContent =
            "Please select at least one food item before placing your order.";
          return;
        }

        if (!getCurrentUser()) {
          orderAlert.textContent = "Please login or create an account before placing your order.";
          authModal.show();
          switchAuthForm(false);
          return;
        }

        if (!orderForm.reportValidity()) {
          return;
        }

        const customerName = document.getElementById("customerName").value.trim();
        const payment = document.getElementById("payment").value;

        orderAlert.className = "alert alert-success";
        orderAlert.textContent =
          "Demo order prepared for " +
          customerName +
          ". Total: " +
          totalElement.textContent +
          ". Payment method: " +
          payment +
          ". No order was saved and no payment was taken. Connect Django backend to submit a real order.";
      });

      updateAuthNavigation();
      updateCart();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

