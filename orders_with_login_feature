<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Order Food | Foodie Restaurant</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />

    <style>
      :root {
        --green: #073b2c;
        --dark-green: #05281f;
        --gold: #ffbd45;
        --cream: #f8f5ed;
        --muted: #687169;
      }

      body {
        margin: 0;
        background: var(--cream);
        color: #202923;
        font-family: Arial, Helvetica, sans-serif;
      }

      .navbar {
        background: var(--dark-green);
        padding: 15px 0;
      }

      .brand {
        font-size: 26px;
        font-weight: bold;
        color: white;
        text-decoration: none;
      }

      .brand i {
        color: var(--gold);
      }

      .nav-link {
        color: white;
      }

      .nav-link:hover {
        color: var(--gold);
      }

      .page-banner {
        background:
          linear-gradient(90deg, rgba(5, 40, 31, 0.97), rgba(5, 40, 31, 0.65)),
          url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1600&q=80");

        background-size: cover;
        background-position: center;
        padding: 65px 0;
        color: white;
      }

      .page-banner h1 {
        font-size: clamp(35px, 5vw, 52px);
        font-weight: 800;
      }

      .page-banner span {
        color: var(--gold);
      }

      .main-section {
        padding: 55px 0;
      }

      .section-heading {
        font-weight: 800;
        margin-bottom: 8px;
      }

      .muted {
        color: var(--muted);
      }

      .food-card {
        height: 100%;
        border: 1px solid #ebe7dc;
        border-radius: 16px;
        overflow: hidden;
        background: white;
        transition: 0.25s;
      }

      .food-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
      }

      .food-card img {
        width: 100%;
        height: 165px;
        object-fit: cover;
      }

      .food-body {
        padding: 18px;
      }

      .food-body h5 {
        font-weight: bold;
        font-size: 18px;
      }

      .food-description {
        color: var(--muted);
        font-size: 13px;
        min-height: 40px;
      }

      .price {
        color: var(--green);
        font-weight: 800;
        font-size: 19px;
      }

      .quantity-input {
        width: 75px;
        border: 1px solid #d8ded7;
        border-radius: 8px;
        padding: 7px;
      }

      .order-panel {
        background: white;
        border: 1px solid #e8e5db;
        border-radius: 18px;
        padding: 25px;
        position: sticky;
        top: 95px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
      }

      .form-label {
        font-weight: 600;
        font-size: 14px;
      }

      .form-control,
      .form-select {
        padding: 12px;
        border-radius: 9px;
        border-color: #deded5;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--green);
        box-shadow: 0 0 0 0.2rem rgba(7, 59, 44, 0.1);
      }

      .total-box {
        background: #edf3e9;
        border-radius: 12px;
        padding: 17px;
        margin-top: 20px;
      }

      .total-price {
        color: var(--green);
        font-size: 27px;
        font-weight: 800;
      }

      .place-order-btn {
        width: 100%;
        background: var(--gold);
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 800;
        color: var(--dark-green);
        transition: 0.2s;
      }

      .place-order-btn:hover {
        background: var(--green);
        color: white;
      }

      .empty-cart {
        color: var(--muted);
        font-size: 14px;
        padding: 10px 0;
      }

      .alert-message {
        display: none;
      }

      footer {
        background: var(--dark-green);
        color: white;
        padding: 25px 0;
        text-align: center;
      }

      footer p {
        margin: 0;
        color: #d4ded7;
      }


      /* LOGIN / REGISTER */
      .auth-btn {
        border: 1px solid var(--gold);
        color: var(--gold);
        border-radius: 8px;
        padding: 7px 15px;
        font-weight: 700;
      }
      .auth-btn:hover {
        background: var(--gold);
        color: var(--dark-green);
      }
      .user-name { color: var(--gold); font-weight: 700; }
      .auth-modal .modal-content {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
      }
      .auth-modal .modal-header {
        background: var(--dark-green);
        color: white;
        border: 0;
      }
      .auth-modal .btn-close { filter: invert(1); }
      .auth-submit {
        background: var(--gold);
        color: var(--dark-green);
        border: 0;
        font-weight: 800;
        padding: 12px;
      }
      .auth-submit:hover { background: var(--green); color: white; }
      .auth-switch { color: var(--green); font-weight: 700; cursor: pointer; }

      @media (max-width: 991px) {
        .order-panel {
          position: static;
        }
      }
    </style>
  </head>

